# -----------------------------------------------------
# ALIASES
# -----------------------------------------------------

# -----------------------------------------------------
# General
# -----------------------------------------------------
alias c='clear'
alias nf='fastfetch'
alias pf='fastfetch'
alias ff='fastfetch'
alias ls='eza -a --icons'
alias ll='eza -al --icons'
alias lt='eza -a --tree --level=1 --icons'
alias shutdown='systemctl poweroff'
alias v='$EDITOR'
alias vim='$EDITOR'
alias wifi='nmtui'
alias android-mount='aft-mtp-mount ~/mnt'

# Removed with the last of ml4w:
#   ts       -- snapshot.sh, which needed timeshift (not installed) and finished
#               by running `grub-mkconfig -o /boot/grub/grub.cfg`. There is no
#               /boot/grub: this machine boots systemd-boot. Its grub-btrfs
#               branch never applied either, the root filesystem being ext4.
#   cleanup  -- `sudo pacman -Rns $(pacman -Qtdq)`, which errors out whenever
#               there are no orphans, i.e. almost always. `pacman -Qtdq` on its
#               own still lists them if you want to look.
#   ascii    -- figlet.sh, a figlet wrapper that copied its output with wl-copy
#               and then again with xclip, the second being an X11 tool on a
#               Wayland session. `figlet <text> | wl-copy` is the whole idea.

# -----------------------------------------------------
# Diagnosis
# -----------------------------------------------------
alias hypr-diagnosis='~/.config/hypr/scripts/diagnosis.sh'
# Renamed from ml4w-diagnosis / ml4w-hyprland-diagnosis. The script is this
# repo's own and always was; only the name came from upstream, and with ml4w
# fully retired there is nothing left for that prefix to refer to.
#
# Also removed, earlier: ml4w-update (ran update.sh, which re-cloned upstream
# and reinstalled straight over this repo), ml4w-qtile-diagnosis (target never
# existed here), ml4w-hyprland (the Hyprland Settings app, deleted along with
# the hyprctl.sh hook that replayed its settings over the config on every
# reload), ml4w-sidebar (ags v1 syntax; the installed ags is v3), and ml4w /
# ml4w-settings themselves -- the Welcome and Dotfiles Settings AppImages.

# -----------------------------------------------------
# Window Managers
# -----------------------------------------------------

alias Qtile='startx'
# Hyprland with Hyprland

# -----------------------------------------------------
# Git
# -----------------------------------------------------
alias gs="git status"
alias ga="git add"
alias gc="git commit -m"
alias gp="git push"
alias gpl="git pull"
alias gst="git stash"
alias gsp="git stash; git pull"
alias gcheck="git checkout"
alias gcredential="git config credential.helper store"

# -----------------------------------------------------
# System
# -----------------------------------------------------
alias update-grub='sudo grub-mkconfig -o /boot/grub/grub.cfg'

# -----------------------------------------------------
# Qtile
# -----------------------------------------------------
alias res1='xrandr --output DisplayPort-0 --mode 2560x1440 --rate 120'
alias res2='xrandr --output DisplayPort-0 --mode 1920x1080 --rate 120'
alias setkb='setxkbmap de;echo "Keyboard set back to de."'
